# `madge` (dev-only circular-dependency checker) declares peerOptional
# typescript@^5.4.4 and has not updated its range for TypeScript 6, which this
# project uses. Without this, `npm ci` / `npm install` fail with ERESOLVE on a
# clean machine. legacy-peer-deps relaxes peer resolution to the npm v6
# behavior so installs are reproducible in CI and locally.
legacy-peer-deps=true
